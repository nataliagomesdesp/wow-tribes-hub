# GitHub API
NEXT_PUBLIC_GITHUB_OWNER=despegar
NEXT_PUBLIC_GITHUB_REPO=wow-playbook
GITHUB_TOKEN=xxx  # For higher API rate limits

# Database (Provided by Ownia)
# These come from APP_SECRETS in Ownia environment
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Analytics (optional)
NEXT_PUBLIC_ANALYTICS_ID=

# API endpoints
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# GitHub Webhook Secret (for Ownia)
GITHUB_WEBHOOK_SECRET=your-webhook-secret
